.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-v2-credit-notes-resend-email - Resend a credit note email


.SH SYNOPSIS
\fBlago v2 credit-notes resend-email  [flags]\fP


.SH DESCRIPTION
Queues an email for a finalized credit note. Requires a premium license and valid billing entity email settings.
Requires the product catalog to be enabled and credit_note write permission on the API key.


.SH OPTIONS
\fB--bcc\fP=""
	Additional recipients.

.PP
\fB--cc\fP=""
	Additional recipients.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for resend-email

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--to\fP=""
	Recipients. When omitted or empty, the customer email is used.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
