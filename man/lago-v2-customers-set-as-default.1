.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-v2-customers-set-as-default - Set the default customer payment method


.SH SYNOPSIS
\fBlago v2 customers set-as-default   [flags]\fP


.SH DESCRIPTION
Sets this payment method as the customer default. No request body is required.
Requires the product catalog to be enabled and payment_method write permission on the API key.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for set-as-default


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago v2 customers set-as-default <customer_external_id> <lago_id>
  lago v2 customers set-as-default <customer_external_id> <lago_id> --output json  # full resource
.EE


.SH SEE ALSO
\fBlago-v2-customers(1)\fP
