.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-payments-create - Create a payment


.SH SYNOPSIS
\fBlago payments create [flags]\fP


.SH DESCRIPTION
This endpoint is used to create a manual payment


.SH OPTIONS
\fB--amount-cents\fP=""
	The payment amount in cents

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	Idempotency key for safe mutation retries

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--invoice-id\fP=""
	Unique identifier assigned to the invoice

.PP
\fB--paid-at\fP=""
	The date the payment was made

.PP
\fB--reference\fP=""
	Reference for the payment


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago payments create --input @payload.json
  lago payments create --input @payload.json --output json  # full resource
.EE


.SH SEE ALSO
\fBlago-payments(1)\fP
