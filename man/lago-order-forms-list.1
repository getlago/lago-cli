.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-order-forms-list - List all order forms


.SH SYNOPSIS
\fBlago order-forms list [flags]\fP


.SH DESCRIPTION
This endpoint is used to list all existing order forms.
This is a premium feature.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--created-at-from\fP=""
	Filter order forms created from a specific date and time, in UTC (ISO 8601).

.PP
\fB--created-at-to\fP=""
	Filter order forms created up to a specific date and time, in UTC (ISO 8601).

.PP
\fB--customer-id\fP=""
	Filter order forms by the Lago identifiers of their customers.

.PP
\fB--expires-at-from\fP=""
	Filter order forms expiring from a specific date and time, in UTC (ISO 8601). Order forms that never expire are excluded.

.PP
\fB--expires-at-to\fP=""
	Filter order forms expiring up to a specific date and time, in UTC (ISO 8601). Order forms that never expire are excluded.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=""
	Maximum number of results

.PP
\fB--number\fP=""
	Filter order forms by their number, as assigned by Lago.

.PP
\fB--owner-id\fP=""
	Filter order forms by the Lago identifiers of the users owning the quote they come from.

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--quote-number\fP=""
	Filter order forms by the number of the quote they come from.

.PP
\fB--search-term\fP=""
	Search order forms by number.

.PP
\fB--status\fP=""
	Filter order forms by status. Possible values are 'generated', 'signed', 'expired' and 'voided'.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago order-forms list
.EE


.SH SEE ALSO
\fBlago-order-forms(1)\fP
