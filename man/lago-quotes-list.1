.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-quotes-list - List all quotes


.SH SYNOPSIS
\fBlago quotes list [flags]\fP


.SH DESCRIPTION
This endpoint is used to list all existing quotes.
Quotes are ordered by creation date, from the most recent to the oldest.
This is a premium feature.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--external-customer-id\fP=""
	Filter quotes by the external unique identifiers of their customers (provided by your own application).

.PP
\fB--from-date\fP=""
	Filter quotes created from a specific date.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=""
	Results per page (1-1000)

.PP
\fB--number\fP=""
	Filter quotes by their number, as assigned by Lago.

.PP
\fB--order-type\fP=""
	Filter quotes by order type. Possible values are 'subscription_creation', 'subscription_amendment' and 'one_off'.

.PP
\fB--owner-id\fP=""
	Filter quotes by the Lago identifiers of the users owning them.

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--status\fP=""
	Filter quotes by the status of their current version. Possible values are 'draft', 'approved' and 'voided'.

.PP
\fB--to-date\fP=""
	Filter quotes created up to a specific date.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago quotes list
.EE


.SH SEE ALSO
\fBlago-quotes(1)\fP
