.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-credit-notes-update - Update a credit note


.SH SYNOPSIS
\fBlago credit-notes update  [flags]\fP


.SH DESCRIPTION
This endpoint updates an existing credit note.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--idempotency-key\fP=""
	Idempotency key for safe mutation retries

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--metadata\fP=""
	Metadata to set as key-value pairs. Keys are strings (max 100 characters), values can be strings (max 255 characters) or null.

.PP
\fB--refund-status\fP=""
	The status of the refund portion of the credit note. It indicates the current state or condition of the refund associated with the credit note. The possible values for this field are:
.IP \(bu 2
\&'pending': this status indicates that the refund is pending execution. The refund request has been initiated but has not been processed or completed yet.
.IP \(bu 2
\&'succeeded': this status indicates that the refund has been successfully executed. The refund amount has been processed and returned to the customer or the designated recipient.
.IP \(bu 2
\&'failed': this status indicates that the refund failed to execute. The refund request encountered an error or unsuccessful processing, and the refund amount could not be returned.; one of: pending, succeeded, failed


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago credit-notes update <lago_id> --input @payload.json
  lago credit-notes update <lago_id> --input @payload.json --output json  # full resource
.EE


.SH SEE ALSO
\fBlago-credit-notes(1)\fP
