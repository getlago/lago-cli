.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-customers-applied-coupons - List all customer's applied coupons


.SH SYNOPSIS
\fBlago customers applied-coupons  [flags]\fP


.SH DESCRIPTION
This endpoint is used to list all applied coupons for a customer.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--coupon-code\fP=""
	The code of the coupon applied to the customer. Use it to filter applied coupons by their code.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for applied-coupons

.PP
\fB--limit\fP=""
	Results per page (1-1000)

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--status\fP=""
	The status of the coupon. Can be either 'active' or 'terminated'.; one of: active, terminated

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago customers applied-coupons <external_customer_id>
.EE


.SH SEE ALSO
\fBlago-customers(1)\fP
