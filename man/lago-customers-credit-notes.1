.nh
.TH "LAGO" "1" "Aug 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-customers-credit-notes - List all customer's credit notes


.SH SYNOPSIS
\fBlago customers credit-notes  [flags]\fP


.SH DESCRIPTION
This endpoint list all existing credit notes for a customer.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--amount-from\fP=""
	Filter credit notes of at least a specific amount. This parameter must be defined in cents to ensure consistent handling for all currency types.

.PP
\fB--amount-to\fP=""
	Filter credit notes up to a specific amount. This parameter must be defined in cents to ensure consistent handling for all currency types.

.PP
\fB--credit-status\fP=""
	Filter credit notes by credit status. Possible values are 'available', 'consumed'  or 'voided'.; one of: available, consumed, voided

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for credit-notes

.PP
\fB--invoice-number\fP=""
	Filter credit notes by their related invoice number.

.PP
\fB--issuing-date-from\fP=""
	Filter credit notes starting from a specific date.

.PP
\fB--issuing-date-to\fP=""
	Filter credit notes up to a specific date.

.PP
\fB--limit\fP=""
	Maximum number of results

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--purchase-order-number\fP=""
	Filter by the invoice purchase order number. The match is exact but case-insensitive.

.PP
\fB--reason\fP=""
	Filter credit notes by reasons. Possible values are 'product_unsatisfactory', 'order_change', 'order_cancellation', 'fraudulent_charge', 'duplicated_charge' or 'other'.; one of: product_unsatisfactory, order_change, order_cancellation, fraudulent_charge, duplicated_charge, other

.PP
\fB--refund-status\fP=""
	Filter credit notes by refund status. Possible values are 'pending', 'succeeded'  or 'failed'.; one of: pending, succeeded, failed

.PP
\fB--search-term\fP=""
	Search credit notes by id, number, customer name, customer external_id or customer email.

.PP
\fB--self-billed\fP=""
	Filter credit notes belonging to a self billed invoice. Possible values are 'true' or 'false'.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago customers credit-notes <external_customer_id>
.EE


.SH SEE ALSO
\fBlago-customers(1)\fP
