.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-credit-notes-estimate - Estimate amounts for a new credit note


.SH SYNOPSIS
\fBlago credit-notes estimate [flags]\fP


.SH DESCRIPTION
This endpoint allows you to retrieve amounts for a new credit note creation.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for estimate

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--invoice-id\fP=""
	The invoice unique identifier, created by Lago.

.PP
\fB--items\fP=""
	The list of credit note's items.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago credit-notes estimate --input @payload.json
.EE


.SH SEE ALSO
\fBlago-credit-notes(1)\fP
