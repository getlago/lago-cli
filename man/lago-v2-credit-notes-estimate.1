.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-v2-credit-notes-estimate - Estimate a credit note


.SH SYNOPSIS
\fBlago v2 credit-notes estimate [flags]\fP


.SH DESCRIPTION
Computes the amounts and taxes without creating a credit note. Items and applied taxes are always included; no expands[] parameter is needed.
Requires the product catalog to be enabled and credit_note write permission on the API key.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for estimate

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--invoice-id\fP=""
	Invoice identifier.

.PP
\fB--items\fP=""
	Fees to credit.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago v2 credit-notes estimate --input @payload.json
.EE


.SH SEE ALSO
\fBlago-v2-credit-notes(1)\fP
