.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-v2-webhook-endpoints-create - Create webhook endpoint


.SH SYNOPSIS
\fBlago v2 webhook-endpoints create [flags]\fP


.SH DESCRIPTION
Creates a webhook endpoint. The organization can have at most ten endpoints, each with a distinct URL.
Requires the product catalog to be enabled and webhook_endpoint write permission on the API key.


.SH OPTIONS
\fB--event-types\fP=""
	Event types to deliver. Null or ["*"] selects all events. Names are trimmed, lowercased and deduplicated. An empty array selects none.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--name\fP=""
	Endpoint name.

.PP
\fB--signature-algo\fP=""
	Webhook signature algorithm.; one of: jwt, hmac

.PP
\fB--webhook-url\fP=""
	Public URL receiving webhook requests. Private addresses are rejected.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago v2 webhook-endpoints create --input @payload.json
  lago v2 webhook-endpoints create --input @payload.json --output json  # full resource
.EE


.SH SEE ALSO
\fBlago-v2-webhook-endpoints(1)\fP
