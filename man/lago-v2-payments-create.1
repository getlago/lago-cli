.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-v2-payments-create - Create payment


.SH SYNOPSIS
\fBlago v2 payments create [flags]\fP


.SH DESCRIPTION
Records a manual payment against an existing invoice. A reference and positive integer amount are required. Premium access and invoice eligibility are checked, except for supported advance-fee payments.
Requires the product catalog to be enabled and payment write permission on the API key.


.SH OPTIONS
\fB--amount-cents\fP=""
	Amount paid, in cents.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--invoice-id\fP=""
	Identifier of the invoice being paid.

.PP
\fB--paid-at\fP=""
	Payment timestamp. Defaults to now.

.PP
\fB--reference\fP=""
	Manual payment reference.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago v2 payments create --input @payload.json
  lago v2 payments create --input @payload.json --output json  # full resource
.EE


.SH SEE ALSO
\fBlago-v2-payments(1)\fP
