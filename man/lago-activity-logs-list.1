.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-activity-logs-list - List all activity logs


.SH SYNOPSIS
\fBlago activity-logs list [flags]\fP


.SH DESCRIPTION
This endpoint retrieves all existing activity logs that represent actions performed on application resources.


.SH OPTIONS
\fB--activity-sources\fP=""
	Filter results by activity sources

.PP
\fB--activity-types\fP=""
	Filter results by activity types

.PP
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--external-customer-id\fP=""
	Unique identifier assigned to the customer in your application.

.PP
\fB--external-subscription-id\fP=""
	External subscription ID

.PP
\fB--from-date\fP=""
	Filter activity logs from a specific date.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=""
	Maximum number of results

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--resource-ids\fP=""
	Filter results by resources unique identifiers

.PP
\fB--resource-types\fP=""
	Filter results by resource class types

.PP
\fB--to-date\fP=""
	Filter activity logs up to a specific date.

.PP
\fB--user-emails\fP=""
	Filter results by user emails

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago activity-logs list
.EE


.SH SEE ALSO
\fBlago-activity-logs(1)\fP
