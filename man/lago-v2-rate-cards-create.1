.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-v2-rate-cards-create - Create rate card


.SH SYNOPSIS
\fBlago v2 rate-cards create [flags]\fP


.SH DESCRIPTION
Requires the product catalog to be enabled and rate_card write permission on the API key.


.SH OPTIONS
\fB--applied-pricing-unit-code\fP=""
	Pricing unit code, or null for currency pricing.

.PP
\fB--billing-timing\fP=""
	When fees are billed.; one of: arrears, advance

.PP
\fB--code\fP=""
	Unique code within the organization.

.PP
\fB--currency\fP=""
	ISO 4217 billing currency.

.PP
\fB--description\fP=""
	Internal description.

.PP
\fB--display-on-invoice\fP=""
	Whether generated fees are shown on invoices.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json

.PP
\fB--name\fP=""
	Name shown in the catalog.

.PP
\fB--product-code\fP=""
	Code of the product being priced.

.PP
\fB--product-filter-code\fP=""
	Filter code belonging to this product.

.PP
\fB--proration\fP=""
	Whether charges are prorated.

.PP
\fB--rates\fP=""
	Initial effective-dated rates. A failure rolls back the card and its rates.

.PP
\fB--regroup-paid-fees\fP=""
	Only for hidden advance fees. Null keeps paid fees standalone.; one of: invoice,

.PP
\fB--tax-codes\fP=""
	Tax codes to assign. An empty array clears the assignments.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago v2 rate-cards create --input @payload.json
  lago v2 rate-cards create --input @payload.json --output json  # full resource
.EE


.SH SEE ALSO
\fBlago-v2-rate-cards(1)\fP
