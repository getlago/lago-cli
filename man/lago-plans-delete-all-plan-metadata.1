.TH "LAGO" "1" "Aug 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-plans-delete-all-plan-metadata - Delete all plan metadata


.SH SYNOPSIS
\fBlago plans delete-all-plan-metadata  [flags]\fP


.SH DESCRIPTION
This endpoint removes all metadata from a plan.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for delete-all-plan-metadata

.PP
\fB--idempotency-key\fP=""
	Idempotency key for safe mutation retries


