.nh
.TH "LAGO" "1" "Aug 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-subscriptions-get - Retrieve a subscription


.SH SYNOPSIS
\fBlago subscriptions get  [flags]\fP


.SH DESCRIPTION
This endpoint retrieves a specific subscription.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for get

.PP
\fB--status\fP=""
	By default, this endpoint only return 'active' subscriptions. If you want to retrieve a subscription with a different 'status', you can specify it here.

.PP
_Note: As there may exists multiple 'canceled' or 'terminated' subscribtions for the same 'external\fIid', it is recommended to use the "List all subscriptions" endpoint to retrieve those subscriptions.\fP; one of: active, terminated, pending, canceled

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago subscriptions get <external_id>
.EE


.SH SEE ALSO
\fBlago-subscriptions(1)\fP
