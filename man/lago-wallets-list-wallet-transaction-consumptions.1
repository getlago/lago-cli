.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-wallets-list-wallet-transaction-consumptions - List all consumptions for a wallet transaction


.SH SYNOPSIS
\fBlago wallets list-wallet-transaction-consumptions  [flags]\fP


.SH DESCRIPTION
This endpoint is used to list all consumption records for an inbound wallet transaction. It shows how the credits from this inbound transaction were consumed by outbound transactions. Only available for traceable wallets.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list-wallet-transaction-consumptions

.PP
\fB--limit\fP=""
	Maximum number of results

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
