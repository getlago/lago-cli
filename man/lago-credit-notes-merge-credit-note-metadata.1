.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-credit-notes-merge-credit-note-metadata - Merge credit note metadata


.SH SYNOPSIS
\fBlago credit-notes merge-credit-note-metadata  [flags]\fP


.SH DESCRIPTION
This endpoint merges the provided metadata with existing metadata on the credit note.
Existing keys not in the request are preserved. New keys are added, existing keys are updated.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for merge-credit-note-metadata

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json


