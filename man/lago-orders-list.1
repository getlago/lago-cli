.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-orders-list - List all orders


.SH SYNOPSIS
\fBlago orders list [flags]\fP


.SH DESCRIPTION
This endpoint is used to list all existing orders.
This is a premium feature.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--customer-id\fP=""
	Filter orders by the Lago identifiers of their customers.

.PP
\fB--executed-at-from\fP=""
	Filter orders executed from a specific date and time, in UTC (ISO 8601). Orders that have not been executed are excluded.

.PP
\fB--executed-at-to\fP=""
	Filter orders executed up to a specific date and time, in UTC (ISO 8601). Orders that have not been executed are excluded.

.PP
\fB--execution-mode\fP=""
	Filter orders by execution mode. Possible values are 'execute_in_lago' and 'order_only'.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=""
	Results per page (1-1000)

.PP
\fB--number\fP=""
	Filter orders by their number, as assigned by Lago.

.PP
\fB--order-form-number\fP=""
	Filter orders by the number of the order form they come from.

.PP
\fB--order-type\fP=""
	Filter orders by the order type of the quote they come from. Possible values are 'subscription_creation', 'subscription_amendment' and 'one_off'.

.PP
\fB--owner-id\fP=""
	Filter orders by the Lago identifiers of the users owning the quote they come from.

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--quote-number\fP=""
	Filter orders by the number of the quote they come from.

.PP
\fB--search-term\fP=""
	Search orders by number.

.PP
\fB--status\fP=""
	Filter orders by status. Possible values are 'created', 'executed' and 'failed'.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago orders list
.EE


.SH SEE ALSO
\fBlago-orders(1)\fP
