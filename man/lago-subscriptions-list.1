.nh
.TH "LAGO" "1" "Aug 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-subscriptions-list - List all subscriptions


.SH SYNOPSIS
\fBlago subscriptions list [flags]\fP


.SH DESCRIPTION
This endpoint retrieves all active subscriptions.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--billing-entity-codes\fP=""
	Filter subscriptions by billing entity codes.

.PP
\fB--currency\fP=""
	Filter the results by currency, expressed as an ISO 4217 code.

.PP
\fB--external-customer-id\fP=""
	The customer external unique identifier (provided by your own application)

.PP
\fB--external-id\fP=""
	Filter subscriptions by their external unique identifier (provided by your own application).

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=""
	Maximum number of results

.PP
\fB--overridden\fP=""
	When set, filters subscriptions by whether their plan is an override of a parent plan. 'true' returns only subscriptions on overridden plans; 'false' returns only those on standard (non-overridden) plans.

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--plan-code\fP=""
	The unique code representing the plan to be attached to the customer. This code must correspond to the code property of one of the active plans.

.PP
\fB--status\fP=""
	If the field is not defined, Lago will return only 'active' subscriptions. However, if you wish to fetch subscriptions by different status you can define them in a status[] query param. Available filter values: 'pending', 'canceled', 'terminated', 'active'.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago subscriptions list
.EE


.SH SEE ALSO
\fBlago-subscriptions(1)\fP
