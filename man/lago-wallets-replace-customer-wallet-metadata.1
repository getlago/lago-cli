.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-wallets-replace-customer-wallet-metadata - Replace wallet metadata


.SH SYNOPSIS
\fBlago wallets replace-customer-wallet-metadata   [flags]\fP


.SH DESCRIPTION
This endpoint replaces all existing metadata on a wallet with the provided key-value pairs.
Any existing metadata keys not included in the request will be removed.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for replace-customer-wallet-metadata

.PP
\fB--input\fP=""
	Complete JSON request body or @file.json


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago wallets replace-customer-wallet-metadata <external_customer_id> <wallet_code> --input @payload.json
.EE


.SH SEE ALSO
\fBlago-wallets(1)\fP
