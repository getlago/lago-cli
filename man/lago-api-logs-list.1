.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-api-logs-list - List all API logs


.SH SYNOPSIS
\fBlago api-logs list [flags]\fP


.SH DESCRIPTION
This endpoint retrieves all existing API logs, which represent the requests made to Lago's API. Logs older than the retention period of your organization are left out. The retention period is 30 days unless another one was set for your organization.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--api-version\fP=""
	Filter results by API version.

.PP
\fB--clients\fP=""
	Filter results by the client that issued the request, as reported by its user agent.

.PP
\fB--from-date\fP=""
	Filter API logs logged at or after this date.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--http-methods\fP=""
	Filter results by HTTP methods.

.PP
\fB--http-statuses\fP=""
	Filter results by HTTP status or by generic request status. When 'succeeded' or 'failed' is passed, the numeric values of the filter are ignored.

.PP
\fB--limit\fP=""
	Results per page (1-1000)

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--request-paths\fP=""
	Filter results by the path of the request. A value containing '*' is matched as a wildcard, otherwise the path must match exactly.

.PP
\fB--to-date\fP=""
	Filter API logs logged at or before this date.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago api-logs list
.EE


.SH SEE ALSO
\fBlago-api-logs(1)\fP
