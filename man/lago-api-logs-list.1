.nh
.TH "LAGO" "1" "Sep 2026" "Lago CLI" "Lago CLI Manual"

.SH NAME
lago-api-logs-list - List all api logs


.SH SYNOPSIS
\fBlago api-logs list [flags]\fP


.SH DESCRIPTION
This endpoint retrieves all existing api logs that represent requests performed to Lago's API.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch every page

.PP
\fB--api-version\fP=""
	Filter results by API version

.PP
\fB--from-date\fP=""
	Filter api logs from a specific date.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--http-methods\fP=""
	Filter results by HTTP methods

.PP
\fB--http-statuses\fP=""
	Filter results by HTTP status or by generic request status

.PP
\fB--limit\fP=""
	Results per page (1-1000)

.PP
\fB--page\fP=""
	Page number.

.PP
\fB--per-page\fP=""
	Number of records per page.

.PP
\fB--request-paths\fP=""
	Filter results by the path of the request

.PP
\fB--to-date\fP=""
	Filter api logs up to a specific date.

.PP
\fB--watch\fP[=false]
	Poll and re-render when the response changes

.PP
\fB--watch-interval\fP=2s
	Polling interval used with --watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	Override the Lago API key

.PP
\fB--api-url\fP=""
	Override the Lago API URL

.PP
\fB--confirm\fP=""
	Confirm a dangerous operation with its resource identifier

.PP
\fB--dry-run\fP[=false]
	Print mutating requests without sending them

.PP
\fB--insecure\fP[=false]
	Allow insecure HTTP or TLS for self-hosted Lago

.PP
\fB--mode\fP=""
	Environment mode: live or test

.PP
\fB--no-retry\fP[=false]
	Disable automatic retries

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format: table, json, or yaml

.PP
\fB--profile\fP=""
	Named profile to use

.PP
\fB--query\fP=""
	JMESPath expression applied to the response

.PP
\fB--timeout\fP=30s
	Total request timeout

.PP
\fB--timing\fP[=false]
	Print request latency breakdown

.PP
\fB--verbose\fP[=false]
	Print redacted request and response details


.SH EXAMPLE
.EX
  lago api-logs list
.EE


.SH SEE ALSO
\fBlago-api-logs(1)\fP
